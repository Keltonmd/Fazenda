{% extends 'layout/auth.html.twig' %}

{% block title %}Cadastro{% endblock %}

{% block extra_css %}
  <link rel="stylesheet" href="{{ asset('css/auth/register.css') }}">
{% endblock %}

{% block body %}
<main class="auth-page" id="register-page">
  {% set nomeInputClass = registerForm.nome.vars.attr.class|default('auth-input') %}
  {% set emailInputClass = registerForm.email.vars.attr.class|default('auth-input') %}
  {% set passwordInputClass = registerForm.password.vars.attr.class|default('auth-input has-toggle') %}
  {% set hasServerErrors = registerForm.vars.submitted and not registerForm.vars.valid %}

  <div class="auth-card">
    <div class="auth-logo">
      <div class="auth-logo-icon">
        <img
          src="{{ asset('img/logo.png') }}"
          alt="AgroPanel — Sistema de Gestão Agropecuária"
          class="logo logo--auth"
          width="54"
          height="54"
        >
      </div>
      <div class="auth-logo-text">
        <span class="auth-logo-name">AgroPanel</span>
        <span class="auth-logo-sub">Gestão Agropecuária</span>
      </div>
    </div>

    <h1 class="auth-title">Criar conta</h1>
    <p class="auth-subtitle">Preencha os dados abaixo para se cadastrar.</p>

    {{ form_start(registerForm, {
      attr: {
        id: 'registerForm',
        novalidate: 'novalidate'
      }
    }) }}
      <div class="auth-input-group">
        {{ form_label(registerForm.nome, null, {
          label_attr: { class: 'auth-label' }
        }) }}
        <div class="auth-input-shell">
          <i class="bi bi-person auth-input-icon"></i>
          {{ form_widget(registerForm.nome, {
            attr: {
              id: 'registerNome',
              class: nomeInputClass ~ (registerForm.nome.vars.errors|length ? ' is-invalid' : '')
            }
          }) }}
        </div>
        <div class="auth-field-errors" id="registerNomeErrors">
          {{ form_errors(registerForm.nome) }}
        </div>
      </div>

      <div class="auth-input-group">
        {{ form_label(registerForm.email, null, {
          label_attr: { class: 'auth-label' }
        }) }}
        <div class="auth-input-shell">
          <i class="bi bi-envelope auth-input-icon"></i>
          {{ form_widget(registerForm.email, {
            attr: {
              id: 'registerEmail',
              class: emailInputClass ~ (registerForm.email.vars.errors|length ? ' is-invalid' : '')
            }
          }) }}
        </div>
        <div class="auth-field-errors" id="registerEmailErrors">
          {{ form_errors(registerForm.email) }}
        </div>
      </div>

      <div class="auth-input-group" style="margin-bottom:.4rem;">
        {{ form_label(registerForm.password, null, {
          label_attr: { class: 'auth-label' }
        }) }}
        <div class="auth-input-shell">
          <i class="bi bi-lock auth-input-icon"></i>
          {{ form_widget(registerForm.password, {
            attr: {
              id: 'registerPassword',
              class: passwordInputClass ~ (registerForm.password.vars.errors|length ? ' is-invalid' : '')
            }
          }) }}
          <button
            type="button"
            id="toggleRegisterPassword"
            class="auth-toggle-pw"
            aria-label="Mostrar/ocultar senha"
            tabindex="-1"
          >
            <i class="bi bi-eye" id="toggleRegisterPasswordIcon"></i>
          </button>
        </div>
        <div class="auth-field-errors" id="registerPasswordErrors">
          {{ form_errors(registerForm.password) }}
        </div>
        <div class="password-reqs" id="password-reqs">
          <span class="pw-req" id="req-length"><i class="bi bi-circle"></i> Mín. 8 chars</span>
          <span class="pw-req" id="req-upper"><i class="bi bi-circle"></i> Maiúscula</span>
          <span class="pw-req" id="req-lower"><i class="bi bi-circle"></i> Minúscula</span>
          <span class="pw-req" id="req-number"><i class="bi bi-circle"></i> Número</span>
          <span class="pw-req" id="req-symbol"><i class="bi bi-circle"></i> Símbolo (!@#)</span>
        </div>
        <div class="password-strength" id="password-strength-bar-wrap">
          <div class="password-strength-bar" id="password-strength-bar"></div>
        </div>
        <span class="password-strength-label" id="password-strength-label"></span>
      </div>

      <button type="submit" class="auth-btn" id="register-submit-btn">
        <span id="register-btn-content">
          <i class="bi bi-person-plus me-1"></i> Criar conta
        </span>
      </button>

      <div class="auth-feedback{% if hasServerErrors %} is-danger{% endif %}" id="registerFeedback" role="alert" aria-live="polite">
        {% if hasServerErrors %}
          {% if registerForm.vars.errors|length %}
            {{ form_errors(registerForm) }}
          {% else %}
            Verifique os campos destacados.
          {% endif %}
        {% endif %}
      </div>
    {{ form_end(registerForm) }}

    <hr class="auth-divider">

    <p class="auth-switch">
      Já tem conta?
      <a href="{{ path('login') }}">Entrar</a>
    </p>
  </div>
</main>
{% endblock %}

{% block extra_js %}
  <script src="{{ asset('js/auth/register.js') }}"></script>
{% endblock %}
