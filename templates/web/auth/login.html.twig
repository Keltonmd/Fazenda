{% extends 'layout/auth.html.twig' %}

{% block title %}Login{% endblock %}

{% block extra_css %}
  <link rel="stylesheet" href="{{ asset('css/auth/login.css') }}">
{% endblock %}

{% block body %}
<main class="auth-page" id="login-page">
  {% set emailInputClass = loginForm.email.vars.attr.class|default('auth-input') %}
  {% set passwordInputClass = loginForm.password.vars.attr.class|default('auth-input has-toggle') %}
  {% set hasServerErrors = loginForm.vars.submitted and not loginForm.vars.valid %}

  <div class="auth-card">

    {# ── Logo ── #}
    <div class="auth-logo">
      <div class="auth-logo-icon">
        <img
          src="{{ asset('img/logo.png') }}"
          alt="AgroPanel — Sistema de Gestão Agropecuária"
          class="logo logo--auth"
          width="54"
          height="54"
        >
      </div>
      <div class="auth-logo-text">
        <span class="auth-logo-name">AgroPanel</span>
        <span class="auth-logo-sub">Gestão Agropecuária</span>
      </div>
    </div>

    {# ── Título ── #}
    <h1 class="auth-title">Bem-vindo de volta</h1>
    <p class="auth-subtitle">Informe seu e-mail e senha para acessar o painel.</p>

    {{ form_start(loginForm, {
      attr: {
        id: 'loginForm',
        novalidate: 'novalidate'
      }
    }) }}

      {# E-mail #}
      <div class="auth-input-group">

        {{ form_label(loginForm.email, null, {
          label_attr: {
            class: 'auth-label'
          }
        }) }}

        <div class="auth-input-shell">
          <i class="bi bi-envelope auth-input-icon"></i>

          {{ form_widget(loginForm.email, {
            attr: {
              class: emailInputClass ~ (loginForm.email.vars.errors|length ? ' is-invalid' : '')
            }
          }) }}
        </div>

        <div class="auth-field-errors" id="loginEmailErrors">
          {{ form_errors(loginForm.email) }}
        </div>

      </div>

      {# Senha #}
      <div class="auth-input-group">

        {{ form_label(loginForm.password, null, {
          label_attr: {
            class: 'auth-label'
          }
        }) }}

        <div class="auth-input-shell">
          <i class="bi bi-lock auth-input-icon"></i>

          {{ form_widget(loginForm.password, {
            attr: {
              class: passwordInputClass ~ (loginForm.password.vars.errors|length ? ' is-invalid' : '')
            }
          }) }}

          <button
            type="button"
            id="toggleLoginPassword"
            class="auth-toggle-pw"
            aria-label="Mostrar/ocultar senha"
            tabindex="-1"
          >
            <i class="bi bi-eye" id="toggleLoginPasswordIcon"></i>
          </button>
        </div>

        <div class="auth-field-errors" id="loginPasswordErrors">
          {{ form_errors(loginForm.password) }}
        </div>

      </div>

      <button type="submit" class="auth-btn" id="login-submit-btn">
        <span id="login-btn-content">
          <i class="bi bi-box-arrow-in-right me-1"></i>
          Entrar no painel
        </span>
      </button>

      <div
        class="auth-feedback{% if hasServerErrors %} is-danger{% endif %}"
        id="loginFeedback"
        role="alert"
        aria-live="polite"
      >
        {% if hasServerErrors %}
          {% if loginForm.vars.errors|length %}
            {{ form_errors(loginForm) }}
          {% else %}
            Verifique os campos destacados.
          {% endif %}
        {% endif %}
      </div>

    {{ form_end(loginForm) }}

    <hr class="auth-divider">

    <p class="auth-switch">
      Não tem conta?
      <a href="{{ path('register') }}">Criar conta</a>
    </p>

  </div>

</main>
{% endblock %}

{% block extra_js %}
  <script src="{{ asset('js/auth/login.js') }}"></script>
{% endblock %}
