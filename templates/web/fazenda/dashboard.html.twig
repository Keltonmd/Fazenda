{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block breadcrumb %}<li class="breadcrumb-item active">Dashboard</li>{% endblock %}

{% block extra_css %}
  <link rel="stylesheet" href="{{ asset('css/fazenda/dashboard.css') }}">
{% endblock %}

{% block body %}

{# ── STAT CARDS — LINHA 1: contagem geral ── #}
<div class="row g-3 mb-3">
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon green"><i class="bi bi-house-door-fill"></i></div>
      <div>
        <div class="stat-value">{{ totalFazendas }}</div>
        <div class="stat-label">Fazendas cadastradas</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon yellow"><i class="fa-solid fa-cow"></i></div>
      <div>
        <div class="stat-value">{{ gadosVivos }}</div>
        <div class="stat-label">Gados vivos</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon blue"><i class="bi bi-person-badge-fill"></i></div>
      <div>
        <div class="stat-value">{{ totalVeterinarios }}</div>
        <div class="stat-label">Veterinários</div>
      </div>
    </div>
  </div>
  <div class="col-6 col-xl-3">
    <div class="stat-card">
      <div class="stat-icon red"><i class="bi bi-scissors"></i></div>
      <div>
        <div class="stat-value">{{ gadosAbatidos }}</div>
        <div class="stat-label">Gados abatidos</div>
      </div>
    </div>
  </div>
</div>

{# ── STAT CARDS — LINHA 2: produção semanal ── #}
<div class="row g-3 mb-4">
  <div class="col-12 col-md-4">
    <div class="stat-card stat-card-prod">
      <div class="stat-icon teal"><i class="bi bi-droplet-fill"></i></div>
      <div class="flex-grow-1">
        <div class="stat-value">{{ leiteSemanal|number_format(1, ',', '.') }} L</div>
        <div class="stat-label">Litros de leite / semana</div>
        <div class="stat-sublabel">Produção semanal total</div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="stat-card stat-card-prod">
      <div class="stat-icon orange"><i class="bi bi-box-seam-fill"></i></div>
      <div class="flex-grow-1">
        <div class="stat-value">{{ racaoSemanal|number_format(1, ',', '.') }} kg</div>
        <div class="stat-label">Kg de ração / semana</div>
        <div class="stat-sublabel">Consumo semanal total</div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="stat-card stat-card-prod stat-card-alert{{ animaisElegiveis > 0 ? ' has-alert' : '' }}">
      <div class="stat-icon purple"><i class="bi bi-exclamation-triangle-fill"></i></div>
      <div class="flex-grow-1">
        <div class="stat-value">{{ animaisElegiveis }}</div>
        <div class="stat-label">Animais jovens (até 1 ano) que consomem mais de 500 kg de ração por semana</div>
        <div class="stat-sublabel">
          {% if animaisElegiveis > 0 %}
            {{ animaisElegiveis }} animal(is) requer(em) atenção
          {% else %}
            Nenhum animal nesta categoria
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{# ── TABELAS RECENTES ── #}
<div class="row g-3 dashboard-panels">

  {# Últimos gados #}
  <div class="col-12 col-xl-6">
    <div class="card dashboard-panel-card h-100">
      <div class="card-header">
        <span><i class="fa-solid fa-cow"></i>  Gados Recentes</span>
        <a href="{{ path('gados_index') }}" class="btn btn-sm btn-outline-primary">Ver todos</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Código</th>
              <th>Peso</th>
              <th>Leite</th>
              <th>Nascimento</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {% if gadosVivos == 0 %}
              <tr><td colspan="5" class="text-center text-muted py-4">
                <i class="bi bi-inbox fs-3 d-block mb-2"></i>Nenhum gado vivo cadastrado.
              </td></tr>
            {% elseif ultimosGados is empty %}
              <tr><td colspan="5" class="text-center text-muted py-4">Nenhum gado recente.</td></tr>
            {% else %}
              {% for g in ultimosGados %}
                <tr>
                  <td class="fw-semibold">{{ g.codigo ?? '—' }}</td>
                  <td>{{ g.peso|number_format(1, ',', '.') }} kg</td>
                  <td>{{ g.leite|number_format(1, ',', '.') }} L/sem</td>
                  <td>{{ g.nascimento ? g.nascimento|date('d/m/Y') : '—' }}</td>
                  <td>
                    <span class="badge-status {{ g.abatido ? 'badge-abatido' : 'badge-ativo' }}">
                      {{ g.abatido ? 'Abatido' : 'Ativo' }}
                    </span>
                  </td>
                </tr>
              {% endfor %}
            {% endif %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  {# Fazendas card #}
  <div class="col-12 col-md-6 col-xl-3">
    <div class="card dashboard-panel-card dashboard-summary-card h-100">
      <div class="card-header">
        <span><i class="bi bi-house-door-fill me-2 text-success"></i>Fazendas</span>
        <a href="{{ path('fazenda_index') }}" class="btn btn-sm btn-outline-primary">Gerenciar</a>
      </div>
      <div class="list-group list-group-flush dashboard-compact-list">
        {% if ultimasFazendas is empty %}
          <div class="list-group-item text-center text-muted py-3 text-sm">Nenhuma fazenda cadastrada.</div>
        {% else %}
          {% for f in ultimasFazendas|slice(0, 5) %}
            <div class="list-group-item d-flex align-items-center gap-3 py-2 px-3 dashboard-list-item">
              <div class="stat-icon stat-icon-small green"><i class="bi bi-house-door"></i></div>
              <div class="flex-grow-1">
                <div class="fw-semibold text-base dashboard-list-title">{{ f.nome }}</div>
                <div class="text-muted text-xs dashboard-list-meta">{{ f.responsavel }} | {{ f.tamanhoHA|number_format(1, ',', '.') }} ha</div>
              </div>
            </div>
          {% endfor %}
          {% if ultimasFazendas|length > 5 %}
            <div class="list-group-item text-center small text-muted">
              +{{ ultimasFazendas|length - 5 }} fazenda(s) recente(s)
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  {# Veterinários card #}
  <div class="col-12 col-md-6 col-xl-3">
    <div class="card dashboard-panel-card dashboard-summary-card h-100">
      <div class="card-header">
        <span><i class="bi bi-person-badge-fill me-2 text-primary"></i>Veterinários</span>
        <a href="{{ path('veterinarios_index') }}" class="btn btn-sm btn-outline-primary">Gerenciar</a>
      </div>
      <div class="list-group list-group-flush dashboard-compact-list">
        {% if ultimosVeterinarios is empty %}
          <div class="list-group-item text-center text-muted py-3 text-sm">Nenhum veterinário cadastrado.</div>
        {% else %}
          {% for v in ultimosVeterinarios|slice(0, 5) %}
            <div class="list-group-item d-flex align-items-center gap-3 py-2 px-3 dashboard-list-item">
              <div class="stat-icon stat-icon-small blue"><i class="bi bi-person-badge"></i></div>
              <div>
                <div class="fw-semibold text-base dashboard-list-title">{{ v.nome }}</div>
                <div class="text-muted text-xs dashboard-list-meta">CRMV: {{ v.crmv }}</div>
              </div>
            </div>
          {% endfor %}
          {% if ultimosVeterinarios|length > 5 %}
            <div class="list-group-item text-center small text-muted">
              +{{ ultimosVeterinarios|length - 5 }} veterinário(s) recente(s)
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% endblock %}